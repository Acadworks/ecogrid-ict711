    classDef sup fill:#e3f2fd,stroke:#1e6fb5,color:#000;
    classDef gen fill:#eeeeee,stroke:#555,color:#000;
    classDef ext fill:#fff,stroke:#999,stroke-dasharray:4 3,color:#000;
    classDef future fill:#fff,stroke:#c0392b,stroke-dasharray:6 4,color:#c0392b;
    class MP core; class ST,ACL,VAL,AV sup; class ID,NT gen; class SM,CL,PP,IDP ext; class KF future;
